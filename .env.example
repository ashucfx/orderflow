# ============================================================
# OrderFlow — Environment Variable Reference
# Copy this file to .env and fill in your local values.
# Never commit .env to version control.
# ============================================================

# --- Application ---
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orderflow
DB_USERNAME=orderflow_user
DB_PASSWORD=changeme

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- JWT ---
JWT_SECRET=replace-with-a-secure-random-256-bit-base64-encoded-secret
JWT_ACCESS_TOKEN_EXPIRY_MS=900000
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# --- Application behaviour ---
CACHE_PRODUCT_TTL_SECONDS=300
IDEMPOTENCY_KEY_TTL_SECONDS=86400
